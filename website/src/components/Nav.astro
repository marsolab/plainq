---
import Logo from "./Logo.astro";

const links = [
  { label: "Why PlainQ", href: "/#reliability" },
  { label: "Patterns", href: "/#patterns" },
  { label: "Deploy", href: "/#deployment" },
  { label: "Docs", href: "/docs/" },
];
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-background)]/90 backdrop-blur-xl">
  <nav
    class="mx-auto flex h-[72px] max-w-[1440px] items-center justify-between gap-4 px-5 sm:px-8"
    aria-label="Primary navigation"
  >
    <div class="flex min-w-0 items-center gap-4">
      <a href="/" class="flex items-center" aria-label="PlainQ home">
        <Logo />
      </a>
      <a
        href="https://github.com/marsolab/plainq"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-2 border-l border-[var(--color-border)] pl-4 font-mono text-[11px] uppercase tracking-[0.08em] text-[var(--color-muted-foreground)] transition-colors hover:text-[var(--color-foreground)] lg:inline-flex"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-success)]"></span>
        Self-hosted · Go
      </a>
    </div>

    <div class="hidden items-center gap-1 lg:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="px-3 py-2 text-sm font-medium text-[var(--color-muted-foreground)] transition-colors hover:text-[var(--color-foreground)]"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <a
        href="/docs/"
        class="px-2 py-2 text-sm font-medium text-[var(--color-muted-foreground)] transition-colors hover:text-[var(--color-foreground)] lg:hidden"
      >
        Docs
      </a>
      <a
        href="https://github.com/marsolab/plainq"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="PlainQ on GitHub"
        class="hidden h-9 w-9 items-center justify-center border border-[var(--color-border)] bg-[var(--color-background)] text-[var(--color-foreground)] transition-colors hover:border-[var(--color-foreground)] sm:inline-flex sm:h-auto sm:w-auto sm:gap-2 sm:px-3 sm:py-2 sm:text-sm sm:font-medium"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.8 18.3 5.1 18.3 5.1c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z" />
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
      <a
        href="/docs/getting-started/quickstart/"
        class="hidden h-9 items-center justify-center bg-[var(--color-primary)] px-4 text-sm font-semibold text-[var(--color-primary-foreground)] transition-transform hover:-translate-y-px sm:inline-flex"
      >
        Get started
      </a>
      <details class="mobile-nav relative sm:hidden" data-mobile-nav>
        <summary
          class="grid h-9 w-9 cursor-pointer list-none place-items-center border border-[var(--color-border)] bg-white"
          aria-label="Open navigation"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <div class="absolute right-0 top-12 w-[min(17rem,calc(100vw-2rem))] border border-[var(--color-border)] bg-white p-3 shadow-[0_24px_60px_rgba(17,19,16,.14)]">
          <div class="grid">
            {links.slice(0, 3).map((link) => (
              <a href={link.href} class="border-b border-[var(--color-border)] px-3 py-3 text-sm font-medium">{link.label}</a>
            ))}
          </div>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <a href="https://github.com/marsolab/plainq" class="inline-flex h-10 items-center justify-center border border-[var(--color-border)] text-sm font-semibold">GitHub</a>
            <a href="/docs/getting-started/quickstart/" class="inline-flex h-10 items-center justify-center bg-[var(--color-primary)] text-sm font-semibold text-white">Get started</a>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll("[data-mobile-nav] a").forEach((link) => {
    link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"));
  });
</script>

<style>
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav[open] summary { border-color: var(--color-foreground); }
</style>
