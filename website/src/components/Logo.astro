---
interface Props {
  class?: string;
  /** Show the "PlainQ" wordmark next to the mark. */
  withWordmark?: boolean;
}
const { class: className, withWordmark = true } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2", className]}>
  <svg
    width="30"
    height="30"
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    <rect width="32" height="32" rx="8" fill="currentColor" />
    <path d="M8 10.5h16M8 16h11M8 21.5h7" class="stroke-[var(--color-background)]" stroke-width="2.5" stroke-linecap="round" />
    <circle cx="23.5" cy="21.5" r="2.2" fill="#315CFF" />
  </svg>
  {
    withWordmark && (
      <span class="font-display text-lg font-bold tracking-[-0.03em]">PlainQ</span>
    )
  }
</span>
