---
import Terminal from "./Terminal.astro";
import StorageTopologyMotion from "./StorageTopologyMotion.tsx";

const deploy = `# Build an image and run one durable node
$ make docker IMAGE=plainq VERSION=dev
$ docker run --rm -p 8080:8080 -p 8081:8081 \\
    -v plainq-data:/data plainq:dev serve \\
    -storage.path=/data/plainq.db \\
    -auth.jwt.secret="$(openssl rand -hex 32)"

# Or install the included Helm chart
$ helm install plainq deploy/helm/plainq \\
    --set auth.jwtSecret="$(openssl rand -hex 32)"`;

---

<section id="deployment" class="border-b border-[var(--color-border)] bg-[var(--color-muted)]">
  <div class="section-shell py-24 sm:py-32">
    <div class="grid items-center gap-14 lg:grid-cols-[1.15fr_.85fr] lg:gap-20">
      <div class="storage-visual">
        <div class="storage-head"><span>Storage topology</span></div>
        <div class="storage-body">
          <StorageTopologyMotion client:load />
        </div>
        <div class="storage-foot"><span>Need machine-level availability?</span><strong>Replicate SQLite state with Raft →</strong></div>
      </div>

      <div>
        <span class="section-label">Storage</span>
        <h2 class="font-display mt-7 max-w-xl text-4xl font-semibold leading-[1.03] tracking-[-0.05em] sm:text-6xl">
          Start small. Add only what you need.
        </h2>
        <p class="mt-6 max-w-xl text-base leading-7 text-[var(--color-muted-foreground)] sm:text-lg">
          Run an embedded SQLite file on one host. Choose Turso for hosted
          SQLite, PostgreSQL for a shared backend, or Raft when replicated
          SQLite availability matters.
        </p>
        <a href="/docs/guides/configuration/" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold underline decoration-[var(--color-border)] underline-offset-4 transition-colors hover:text-[var(--color-accent)]">
          Compare storage options <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="mt-24 grid gap-12 border-t border-[var(--color-border)] pt-24 lg:grid-cols-[.75fr_1.25fr] lg:gap-20 sm:mt-32 sm:pt-32">
      <div>
        <span class="section-label">Deployment</span>
        <h2 class="font-display mt-7 max-w-lg text-4xl font-semibold leading-[1.03] tracking-[-0.05em] sm:text-5xl">
          Deploy like the rest of your stack.
        </h2>
        <p class="mt-6 max-w-lg text-base leading-7 text-[var(--color-muted-foreground)]">
          Copy the binary to a host, build the distroless non-root container,
          or install the Helm chart. The operator can manage servers, queues,
          topics, and accounts declaratively on Kubernetes.
        </p>
        <ul class="mt-9 grid gap-3 font-mono text-[11px] text-[var(--color-muted-foreground)]">
          <li class="flex items-center gap-3"><span class="deploy-check">✓</span> single process + local file</li>
          <li class="flex items-center gap-3"><span class="deploy-check">✓</span> Docker + persistent volume</li>
          <li class="flex items-center gap-3"><span class="deploy-check">✓</span> Helm + Kubernetes operator</li>
        </ul>
      </div>
      <div class="min-w-0"><Terminal code={deploy} title="deploy.sh" /></div>
    </div>
  </div>
</section>

<style>
  .storage-visual { overflow:hidden; border:1px solid var(--color-border); background:#fff; box-shadow:0 28px 70px rgba(17,19,16,.07); }
  .storage-head { display:flex; align-items:center; border-bottom:1px solid var(--color-border); padding:17px 20px; font:600 12px/1 var(--font-display); }
  .storage-body { min-height:360px; padding:44px; background-image:radial-gradient(var(--color-border) .7px,transparent .7px); background-size:18px 18px; }
  .storage-foot { display:flex; align-items:center; justify-content:space-between; gap:16px; border-top:1px solid var(--color-border); background:var(--color-muted); padding:16px 20px; font-size:11px; color:var(--color-muted-foreground); }
  .storage-foot strong { color:var(--color-foreground); font-weight:600; }
  .deploy-check { display:inline-grid; width:20px; height:20px; place-items:center; background:#e9f8f2; color:#08734f; }
  @media (max-width:600px) {
    .storage-head,.storage-foot { align-items:flex-start; flex-direction:column; }
    .storage-body { min-height:0; padding:28px 20px; }
  }
</style>
