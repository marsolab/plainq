---
const items = [
  {
    title: "Stay responsive",
    detail: "Keep slow work from making people wait.",
  },
  {
    title: "Finish the work",
    detail: "Unfinished jobs stay ready for another try.",
  },
  {
    title: "Handle the rush",
    detail: "Add help when demand climbs.",
  },
  {
    title: "See it clearly",
    detail: "Know what is waiting, working, and done.",
  },
];
---

<section class="border-b border-[var(--color-border)] bg-[var(--color-muted)]" aria-label="What PlainQ helps you do">
  <div class="section-shell grid grid-cols-2 divide-x divide-[var(--color-border)] md:grid-cols-4">
    {
      items.map((item, index) => (
        <div class:list={[
          "min-w-0 px-4 py-7 sm:px-6 sm:py-9",
          index === 1 && "border-l border-[var(--color-border)]",
          index === 2 && "border-t border-[var(--color-border)] md:border-l md:border-t-0",
          index === 3 && "border-l border-t border-[var(--color-border)] md:border-t-0",
        ]}>
          <h2 class="font-display text-lg font-semibold leading-[1.05] tracking-[-0.035em] sm:text-xl">
            {item.title}
          </h2>
          <p class="mt-3 text-sm leading-5 text-[var(--color-muted-foreground)]">
            {item.detail}
          </p>
        </div>
      ))
    }
  </div>
</section>
