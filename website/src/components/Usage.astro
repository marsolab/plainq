---
import Terminal from "./Terminal.astro";

const queue = `# One message, one worker group
$ plainq create \\
    -visibility-timeout=30 \\
    -max-receive-attempts=5 \\
    -drop-policy=dead-letter \\
    my-queue

$ plainq send -message='{"job":"resize"}' "$QID"
$ plainq receive -batch=10 -ack "$QID"

# Machine-readable output for scripts and agents
$ plainq list -json | jq '.queues[].queue_name'`;

const pubsub = `# 1. Create a topic
POST /api/v1/queue/topics/
{"topicName":"order-events"}

# 2. Attach each existing queue
POST /api/v1/queue/topics/:topicId/subscriptions
{"queueId":"email-workers-id"}

# 3. Publish once; every attached queue gets a copy
POST /api/v1/queue/topics/:topicId/publish
{"messages":[{"body":"eyJvcmRlcklkIjo0Mn0="}]}`;
---

<section id="usage" class="border-b border-[var(--color-border)] bg-[var(--color-muted)]">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Choose the delivery pattern that fits
      </h2>
      <p class="mt-4 text-lg text-[var(--color-muted-foreground)]">
        Send jobs to a queue for competing consumers. Publish events to a topic
        to fan out into independent queues — without adding another broker.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <div class="min-w-0">
        <h3 class="mb-3 font-mono text-sm font-medium text-[var(--color-muted-foreground)]">
          Work queue · CLI
        </h3>
        <Terminal code={queue} title="plainq" />
      </div>
      <div class="min-w-0">
        <h3 class="mb-3 font-mono text-sm font-medium text-[var(--color-muted-foreground)]">
          Pub/sub · HTTP
        </h3>
        <Terminal code={pubsub} title="topics.http" />
      </div>
    </div>
  </div>
</section>
