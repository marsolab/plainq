---
// Inline SVG icon paths (lucide-style, 24x24, stroke=currentColor).
const features = [
  {
    title: "Reliable work queues",
    body: "At-least-once delivery, visibility timeouts, retries, retention, and dead-letter queues give workers room to fail and recover.",
    icon: "M5 12h14 M13 6l6 6-6 6 M5 6v12",
  },
  {
    title: "Fan-out pub/sub",
    body: "Create a topic, attach existing queues, and publish once. Every queue gets a durable copy with its own retry, retention, and dead-letter policy.",
    icon: "M12 3v6 M6 21v-6 M18 21v-6 M6 15h12 M6 15l6-6 6 6",
  },
  {
    title: "One binary, no broker fleet",
    body: "Start the queue and topic APIs, Houston admin UI, metrics, and storage in one Go process. No ZooKeeper or separate broker cluster.",
    icon: "M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.3 7 12 12l8.7-5 M12 22V12",
  },
  {
    title: "APIs for every workflow",
    body: "Use typed gRPC, the CLI, or the TUI for queues. Use HTTP for topics, publishing, and app or admin integrations.",
    icon: "m8 9 3 3-3 3 M13 15h3 M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z",
  },
  {
    title: "Choose your storage",
    body: "Use embedded SQLite by default, Turso when you want hosted SQLite, or PostgreSQL for a shared backend across instances.",
    icon: "M12 8c4.97 0 9-1.34 9-3s-4.03-3-9-3-9 1.34-9 3 4.03 3 9 3z M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5 M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3",
  },
  {
    title: "Scale without changing the model",
    body: "Start on one node. Add Raft-based clustering or deploy with Docker and Helm when availability and throughput demand it.",
    icon: "M12 2v6 M5 22v-4 M19 22v-4 M5 18h14 M5 18l7-10 7 10",
  },
];
---

<section id="features" class="border-b border-[var(--color-border)]">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Two messaging patterns. One small system.
      </h2>
      <p class="mt-4 text-lg text-[var(--color-muted-foreground)]">
        Use a queue when one worker group should handle each message. Use a topic
        when every subscribed queue needs its own copy.
      </p>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-border)] sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <div class="bg-[var(--color-card)] p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-md border border-[var(--color-border)] bg-[var(--color-muted)]">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={feature.icon} />
              </svg>
            </div>
            <h3 class="mt-4 font-semibold">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted-foreground)]">
              {feature.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
