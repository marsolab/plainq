---
const promises = [
  {
    title: "At-least-once delivery",
    body: "A received message is hidden while work is in progress. If the worker disappears, it becomes available again.",
  },
  {
    title: "Retries with an end",
    body: "Set visibility, retention, and receive limits per queue. Drop exhausted work or send it to a dead-letter queue.",
  },
  {
    title: "Efficient batches",
    body: "Send many messages in one call and receive batches of up to ten when workers are ready for more.",
  },
  {
    title: "Payloads stay yours",
    body: "PlainQ carries bytes as-is: JSON, protobuf, text, or a pointer to a larger object.",
  },
];
---

<section id="reliability" class="border-b border-[var(--color-border)]">
  <div class="section-shell py-24 sm:py-32">
    <div class="grid gap-12 lg:grid-cols-[.82fr_1.18fr] lg:gap-20">
      <div>
        <span class="section-label">Why PlainQ</span>
        <h2 class="font-display mt-7 max-w-xl text-4xl font-semibold leading-[1.02] tracking-[-0.05em] sm:text-6xl">
          Workers fail. Messages wait. That’s normal.
        </h2>
        <p class="mt-6 max-w-xl text-base leading-7 text-[var(--color-muted-foreground)] sm:text-lg">
          PlainQ keeps unfinished work available without forcing your application
          to coordinate every worker. The delivery model is small enough to
          explain—and complete enough to trust.
        </p>

        <div class="mt-12 border-t border-[var(--color-border)]">
          {
            promises.map((item) => (
              <article class="grid gap-2 border-b border-[var(--color-border)] py-5 sm:grid-cols-[1fr_1.25fr] sm:gap-6">
                <h3 class="text-sm font-semibold">{item.title}</h3>
                <p class="text-sm leading-6 text-[var(--color-muted-foreground)]">{item.body}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div class="lifecycle-panel self-start lg:sticky lg:top-28">
        <div class="lifecycle-head">
          <span>Message lifecycle</span>
          <code>visibility_timeout = 30s</code>
        </div>
        <div class="lifecycle-body">
          <div class="life-row">
            <span class="life-index">01</span>
            <span class="life-line"><i></i></span>
            <div><span class="life-state blue">queued</span><strong>job_4021 is ready</strong><p>A worker can receive it now.</p></div>
          </div>
          <div class="life-row">
            <span class="life-index">02</span>
            <span class="life-line"><i></i></span>
            <div><span class="life-state amber">in flight</span><strong>Worker 01 receives it</strong><p>Hidden from other workers for 30 seconds.</p></div>
          </div>
          <div class="life-row split-row">
            <span class="life-index">03</span>
            <span class="life-line"><i></i></span>
            <div class="outcomes">
              <div><span class="life-state green">acknowledged</span><strong>Work finished</strong><p>The message is removed.</p></div>
              <div><span class="life-state gray">timeout</span><strong>Worker disappeared</strong><p>Attempt 2 becomes ready.</p></div>
            </div>
          </div>
        </div>
        <div class="lifecycle-foot"><span class="status-dot"></span> Queue state persisted</div>
      </div>
    </div>
  </div>
</section>

<style>
  .lifecycle-panel { overflow:hidden; border:1px solid var(--color-border); background:#fff; box-shadow:0 28px 70px rgba(17,19,16,.07); }
  .lifecycle-head { display:flex; justify-content:space-between; gap:16px; padding:18px 20px; border-bottom:1px solid var(--color-border); font:600 12px/1 var(--font-display); }
  .lifecycle-head code { font:500 10px/1 var(--font-mono); color:var(--color-muted-foreground); }
  .lifecycle-body { padding:34px 26px 22px; background-image:radial-gradient(var(--color-border) .7px,transparent .7px); background-size:18px 18px; }
  .life-row { display:grid; grid-template-columns:30px 28px 1fr; min-height:142px; }
  .life-index { padding-top:4px; font:500 10px/1 var(--font-mono); color:var(--color-muted-foreground); }
  .life-line { position:relative; width:1px; height:100%; background:var(--color-border); }
  .life-line i { position:absolute; top:0; left:-4px; width:9px; height:9px; border:2px solid #fff; border-radius:999px; background:var(--color-accent); box-shadow:0 0 0 1px #9cafef; }
  .life-row:last-child .life-line { background:linear-gradient(var(--color-border) 0 38%,transparent 38%); }
  .life-row > div { padding-bottom:26px; }
  .life-state { display:inline-flex; margin-bottom:12px; padding:5px 7px; font:500 9px/1 var(--font-mono); letter-spacing:.06em; text-transform:uppercase; }
  .blue { background:var(--color-accent-soft); color:var(--color-accent); }
  .amber { background:#fff7e7; color:#9a6000; }
  .green { background:#e9f8f2; color:#08734f; }
  .gray { background:var(--color-muted); color:var(--color-muted-foreground); }
  .life-row strong { display:block; font:600 17px/1.2 var(--font-display); letter-spacing:-.02em; }
  .life-row p { margin-top:7px; font-size:13px; line-height:1.6; color:var(--color-muted-foreground); }
  .outcomes { display:grid; grid-template-columns:1fr 1fr; gap:1px; border:1px solid var(--color-border); background:var(--color-border); }
  .outcomes > div { min-width:0; padding:18px; background:#fff; }
  .outcomes strong { font-size:14px; }
  .lifecycle-foot { display:flex; align-items:center; gap:9px; border-top:1px solid var(--color-border); background:var(--color-muted); padding:15px 20px; font:500 10px/1 var(--font-mono); color:var(--color-muted-foreground); }
  .status-dot { width:6px; height:6px; border-radius:999px; background:var(--color-success); box-shadow:0 0 0 4px rgba(14,159,110,.1); }
  @media (max-width:560px) {
    .lifecycle-head { align-items:flex-start; flex-direction:column; }
    .lifecycle-body { padding-inline:18px; }
    .outcomes { grid-template-columns:1fr; }
  }
</style>
