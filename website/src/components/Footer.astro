---
import Logo from "./Logo.astro";

const columns = [
  {
    title: "Product",
    links: [
      { label: "Reliability", href: "/#reliability" },
      { label: "Patterns", href: "/#patterns" },
      { label: "Interfaces", href: "/#interfaces" },
      { label: "Deployment", href: "/#deployment" },
    ],
  },
  {
    title: "Learn",
    links: [
      { label: "Documentation", href: "/docs/" },
      { label: "Quickstart", href: "/docs/getting-started/quickstart/" },
      { label: "Core concepts", href: "/docs/getting-started/core-concepts/" },
      { label: "Configuration", href: "/docs/guides/configuration/" },
    ],
  },
  {
    title: "Code",
    links: [
      { label: "GitHub", href: "https://github.com/marsolab/plainq" },
      { label: "Go SDK", href: "https://github.com/marsolab/plainq-go-sdk" },
      { label: "Buf schema", href: "https://buf.build/plainq/schema" },
      { label: "Issues", href: "https://github.com/marsolab/plainq/issues" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-background)]">
  <div class="section-shell py-16 sm:py-20">
    <div class="grid gap-14 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex" aria-label="PlainQ home"><Logo /></a>
        <p class="mt-5 max-w-xs text-sm leading-6 text-[var(--color-muted-foreground)]">
          Reliable work queues, a typed gRPC API, and the operational basics in
          one self-hosted Go binary.
        </p>
        <a href="/docs/getting-started/quickstart/" class="mt-7 inline-flex items-center gap-2 text-sm font-semibold underline decoration-[var(--color-border)] underline-offset-4 hover:text-[var(--color-accent)]">
          Run PlainQ <span aria-hidden="true">→</span>
        </a>
      </div>

      {
        columns.map((column) => (
          <div>
            <h3 class="font-mono text-[10px] uppercase tracking-[.09em] text-[var(--color-muted-foreground)]">{column.title}</h3>
            <ul class="mt-5 space-y-3">
              {column.links.map((link) => (
                <li><a href={link.href} class="text-sm text-[var(--color-muted-foreground)] transition-colors hover:text-[var(--color-foreground)]">{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-16 flex flex-col justify-between gap-4 border-t border-[var(--color-border)] pt-6 font-mono text-[10px] uppercase tracking-[.06em] text-[var(--color-muted-foreground)] sm:flex-row">
      <p>© {year} PlainQ</p>
      <p>Simple by design · observable by default</p>
    </div>
  </div>
</footer>
