---
import QueueVisual from "./QueueVisual.astro";
---

<section class="relative overflow-hidden border-b border-[var(--color-border)]">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(90deg,transparent_49.95%,rgba(17,19,16,.045)_50%,transparent_50.05%)]"></div>
  <div class="section-shell pb-14 pt-20 sm:pb-20 sm:pt-28">
    <div class="grid items-end gap-10 lg:grid-cols-[1.35fr_.65fr] lg:gap-16">
      <div class="hero-reveal">
        <h1 class="font-display max-w-[980px] text-[clamp(2.8rem,5vw,4.5rem)] font-semibold leading-[.92] tracking-[-0.065em]">
          <span class="block">Queue and Pub/Sub.</span>
          <span class="block text-[var(--color-muted-foreground)]">For humans and agents.</span>
        </h1>
      </div>

      <div class="hero-reveal max-w-xl lg:pb-2" style="animation-delay: 100ms">
        <p class="text-balance text-base leading-7 text-[var(--color-muted-foreground)] sm:text-lg sm:leading-8">
          Give people a direct CLI and admin UI, and give agents a self-describing
          JSON command surface. Underneath, durable queues, retries, dead-lettering,
          and topic fan-out run in one simple binary.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="/docs/getting-started/quickstart/"
            class="inline-flex h-11 items-center justify-center bg-[var(--color-primary)] px-5 text-sm font-semibold text-[var(--color-primary-foreground)] transition-transform hover:-translate-y-px"
          >
            Run PlainQ&nbsp; <span aria-hidden="true">→</span>
          </a>
          <a
            href="https://github.com/marsolab/plainq"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 items-center justify-center border border-[var(--color-border)] bg-white px-5 text-sm font-semibold transition-colors hover:border-[var(--color-foreground)]"
          >
            View source
          </a>
        </div>
      </div>
    </div>

    <div class="hero-reveal mt-14 sm:mt-20" style="animation-delay: 180ms">
      <QueueVisual />
    </div>
  </div>
</section>
